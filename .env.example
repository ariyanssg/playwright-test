# Optional Google Search Console OAuth credentials.
# Add both localhost callbacks to the OAuth client:
#   http://127.0.0.1:4173/api/auth/google/callback
#   http://127.0.0.1:4174/oauth2/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional SearchApi.io key for Google site: result discovery.
SEARCHAPI_API_KEY=

# Optional DataForSEO API credentials for backlink discovery.
# The API is provider-billed. The default scan cap is 100,000 rows per site.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Optional Google Places API (New) key for the --check-hours opening-hours comparison.
# Enable "Places API (New)" in Google Cloud. Text Search and Place Details are billed per
# request, and asking for opening hours puts the call in a higher-priced field tier.
GOOGLE_MAPS_API_KEY=

# Optional storage overrides. Reports default to ./output/runs.
SEO404_CONFIG_DIR=
SEO404_DATA_DIR=
