# Optional Google OAuth client (type "Web application") for Search Console AND the
# managed Google Business Profile mode. Add both callbacks under "Authorized redirect URIs":
#   http://127.0.0.1:4173/api/auth/google/callback   (dashboard: Search Console + Business Profile)
#   http://127.0.0.1:4174/oauth2/callback            (CLI: npm run cli -- auth google)
# Open the dashboard at http://127.0.0.1:4173, not localhost:4173, or Google reports
# "Error 400: redirect_uri_mismatch".
# Business Profile also needs "My Business Account Management API" and "My Business Business
# Information API" enabled, plus Google's approval of the project's Business Profile API access
# (https://developers.google.com/my-business/content/prereqs); until then its quota is 0.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Google result discovery APIs. With the Auto provider the cheapest configured one is
# used first, falling back in this order: Serper -> SearchApi -> free local browser.
#
# Serper (https://serper.dev): about $0.30-$1.00 per 1,000 result pages; 2,500 free queries.
SERPER_API_KEY=
#
# SearchApi.io: $1.00-$4.00 per 1,000 result pages. Can stay as a fallback or be removed.
SEARCHAPI_API_KEY=

# Optional DataForSEO API credentials for backlink discovery.
# The API is provider-billed. The default scan cap is 100,000 rows per site.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Optional Google Places API (New) key for the --check-hours opening-hours comparison.
# Enable "Places API (New)" in Google Cloud. Text Search and Place Details are billed per
# request, and asking for opening hours puts the call in a higher-priced field tier.
GOOGLE_MAPS_API_KEY=

# Optional storage overrides. Reports default to ./output/runs.
SEO404_CONFIG_DIR=
SEO404_DATA_DIR=
